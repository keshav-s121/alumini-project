# UniTrack Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/unitrack_db

# JWT secret key (use a long random string in production)
JWT_SECRET=unitrack_super_secret_change_in_production_2024

# Server port
PORT=5000

# Node environment
NODE_ENV=development
